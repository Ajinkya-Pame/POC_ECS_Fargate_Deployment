// ========== Destroy Pipeline (EKS) ==========
pipeline {
    agent any
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'prod'], description: 'Target environment to DESTROY')
    }
    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        AWS_DEFAULT_REGION    = 'ap-south-1'
    }
    stages {
        stage('Configure kubectl') {
            steps { script { configureKubectl() } }
        }
        stage('Uninstall Helm Releases') {
            steps { script { uninstallHelm() } }
        }
        stage('Terraform Init') {
            steps { dir('infra') { script { terraformInit() } } }
        }
        stage('Terraform Plan (Destroy)') {
            steps { dir('infra') { script { terraformPlanDestroy() } } }
        }
        stage('Approve Destruction') {
            steps {
                input message: "DESTROY all ${params.ENVIRONMENT} infrastructure?", ok: 'Destroy Everything'
            }
        }
        stage('Terraform Destroy') {
            steps { dir('infra') { script { terraformDestroy() } } }
        }
    }
    post {
        always { cleanWs(); echo 'Pipeline complete.' }
        success { echo "Infrastructure destroyed for ${params.ENVIRONMENT}!" }
        failure { echo "Destruction failed for ${params.ENVIRONMENT}!" }
    }
}

// ========== Functions ==========
def configureKubectl() {
    def clusters = [dev: 'memecricket-dev-cluster', qa: 'memecricket-qa-cluster', prod: 'memecricket-prod-cluster']
    env.CLUSTER_NAME = clusters[params.ENVIRONMENT]
    env.ENVIRONMENT = params.ENVIRONMENT
    sh "aws eks update-kubeconfig --name ${env.CLUSTER_NAME} --region ${AWS_DEFAULT_REGION} || true"
}

def uninstallHelm() {
    sh '''
    helm uninstall cricket -n cricket || true
    helm uninstall aws-load-balancer-controller -n kube-system || true
    kubectl delete namespace cricket || true
    '''
}

def terraformInit() {
    sh "terraform init -backend-config=./environments/${params.ENVIRONMENT}/backend.config"
}

def terraformPlanDestroy() {
    sh "terraform plan -destroy -var-file=environments/${params.ENVIRONMENT}/${params.ENVIRONMENT}.tfvars -out=tfplan-destroy"
}

def terraformDestroy() {
    sh 'terraform apply -auto-approve tfplan-destroy'
}
