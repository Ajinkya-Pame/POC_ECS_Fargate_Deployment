// ========== Frontend Pipeline (EKS) ==========
pipeline {
    agent any
    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'qa', 'prod'], description: 'Target deployment environment')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Override the container image tag for deployment/rollback. Leave empty to use latest commit.')
    }
    environment {
        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')
        ECR_REGISTRY          = credentials('ECR_REGISTRY')
        AWS_DEFAULT_REGION    = 'ap-south-1'
        COMMIT_ID    = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : ''}"
        RESOLVED_TAG = "${params.IMAGE_TAG ?: 'frontend-' + COMMIT_ID}"
    }
    stages {
        stage('Setup') {
            steps { script { setup() } }
        }
        stage('Build in DEV') {
            when { expression { params.ENVIRONMENT == 'dev' && params.IMAGE_TAG == '' } }
            steps { dir('src/frontend') { script { build() } } }
        }
        stage('Security Scan') {
            when { expression { params.ENVIRONMENT == 'dev' && params.IMAGE_TAG == '' } }
            steps { script { trivyScan() } }
        }
        stage('Push to DEV ECR') {
            when { expression { params.ENVIRONMENT == 'dev' && params.IMAGE_TAG == '' } }
            steps { script { push() } }
        }
        stage('Deploy to EKS DEV') {
            when { expression { params.ENVIRONMENT == 'dev' } }
            steps { script { deployToEKS() } }
        }
        stage('Pull and Push Image to QA') {
            when { expression { params.ENVIRONMENT == 'qa' } }
            steps { script { pullTagAndPush() } }
        }
        stage('Deploy to EKS QA') {
            when { expression { params.ENVIRONMENT == 'qa' } }
            steps { script { deployToEKS() } }
        }
        stage('Approve Prod Deployment') {
            when { expression { params.ENVIRONMENT == 'prod' } }
            steps { input message: "Deploy frontend to EKS in PROD?", ok: 'Deploy' }
        }
        stage('Pull and Push Image to PROD') {
            when { expression { params.ENVIRONMENT == 'prod' } }
            steps { script { pullTagAndPush() } }
        }
        stage('Deploy to EKS PROD') {
            when { expression { params.ENVIRONMENT == 'prod' } }
            steps { script { deployToEKS() } }
        }
    }
    post {
        always { script { cleanup() }; echo 'Pipeline complete.' }
        success { echo "${params.ENVIRONMENT} Deployment successful! Image: ${RESOLVED_TAG}" }
        failure { echo "${params.ENVIRONMENT} Pipeline failed. Please check the logs." }
    }
}

// ========== Functions ==========
def setup() {
    env.AWS_ACCOUNT_ID = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
    env.ECR_REPOSITORY = "${params.ENVIRONMENT}-frontend-memecricket"
    env.ENVIRONMENT = params.ENVIRONMENT
    sh 'aws ecr get-login-password --region $AWS_DEFAULT_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY'
}

def build() {
    sh 'docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:${RESOLVED_TAG} .'
}

def trivyScan() {
    sh '''
    trivy image --exit-code 0 --severity HIGH,CRITICAL --format json -o trivy-report.json $ECR_REGISTRY/$ECR_REPOSITORY:${RESOLVED_TAG}
    trivy convert --format template --template "@/usr/local/share/trivy/templates/html.tpl" -o trivy-report.html trivy-report.json
    '''
    archiveArtifacts artifacts: 'trivy-report.json, trivy-report.html', allowEmptyArchive: true
}

def push() {
    sh 'docker push $ECR_REGISTRY/$ECR_REPOSITORY:${RESOLVED_TAG}'
}

def pullTagAndPush() {
    def sourceRepo = params.ENVIRONMENT == "qa" ? "dev-frontend-memecricket" : "qa-frontend-memecricket"
    def targetRepo = "${params.ENVIRONMENT}-frontend-memecricket"
    withEnv(["SOURCE_REPO=${sourceRepo}", "TARGET_REPO=${targetRepo}"]) {
        sh '''
        docker pull $ECR_REGISTRY/$SOURCE_REPO:$RESOLVED_TAG
        docker tag $ECR_REGISTRY/$SOURCE_REPO:$RESOLVED_TAG $ECR_REGISTRY/$TARGET_REPO:$RESOLVED_TAG
        docker push $ECR_REGISTRY/$TARGET_REPO:$RESOLVED_TAG
        '''
    }
}

def deployToEKS() {
    def clusters = [dev: 'memecricket-dev-cluster', qa: 'memecricket-qa-cluster', prod: 'memecricket-prod-cluster']
    env.CLUSTER_NAME = clusters[params.ENVIRONMENT]
    sh '''
        aws eks update-kubeconfig --name ${CLUSTER_NAME} --region ${AWS_DEFAULT_REGION}

        IMAGE_URI="${ECR_REGISTRY}/${ECR_REPOSITORY}:${RESOLVED_TAG}"

        kubectl set image deployment/frontend frontend=${IMAGE_URI} -n cricket
        kubectl rollout status deployment/frontend -n cricket --timeout=120s
    '''
}

def cleanup() {
    sh 'docker logout $ECR_REGISTRY || true'
    sh 'docker rmi $ECR_REGISTRY/$ECR_REPOSITORY:${RESOLVED_TAG} || true'
    sh 'docker image prune -f || true'
    cleanWs()
}
